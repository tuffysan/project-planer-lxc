[Unit]
Description=Project Planer
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/project-plan/current
Environment=PORT=8080
Environment=PYTHONUNBUFFERED=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/opt/project-plan/current-venv/bin/gunicorn --workers 2 --threads 4 --bind 0.0.0.0:${PORT} --timeout 120 app.app:app
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
